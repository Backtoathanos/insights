# DO NOT MODIFY this file manually or the application might crash
# This file is generated by Acelle and is not intended for editing
# Update your application environment's settings in the admin web UI instead
APP_NAME='Acelle'
APP_ENV=local
APP_LOCALE=en
APP_TIMEZONE=UTC
APP_KEY=
APP_DEBUG=true
APP_DEMO=false
APP_URL=http://localhost
APP_BRAND=false
APP_SAAS=true
APP_CARTPAYE=false
APP_DEFAULT_LOGO_LIGHT="images/logo_light.svg"
APP_DEFAULT_LOGO_DARK="images/logo_dark.svg"
APP_JAPAN=false

# Load the related profile config file
# For example: if APP_PROFILE=limit, then Laravel shall load the config/limit.php file
APP_PROFILE=
APP_DRYRUN=false

LOG_CHANNEL=stack
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_TABLES_PREFIX=
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
FILESYSTEM_DRIVER=local
QUEUE_CONNECTION=database
SESSION_DRIVER=file
SESSION_LIFETIME=120

MEMCACHED_HOST=127.0.0.1

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=mailhog
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"

RECAPTCHA_SITEKEY=6LfyISoTAAAAABJV8zycUZNLgd0sj-sBFjctzXKw
RECAPTCHA_SECRET=6LfyISoTAAAAAC0hJ916unwi0m_B0p7fAvCRK4Kp

LICENSE_VALIDATION_ENDPOINT=http://verify.acellemail.com

APP_STORE=false

# Digest newsletter - optional: set to sync webhook subscribers to brsubscribers
# NEWSLETTER_DIGEST_MAIL_LIST_ID=1

# Marketing email - articles API and blog URL (optional)
# MARKETING_ARTICLES_API_URL=https://adminapi.blackridgeresearch.com/articles/sections
# MARKETING_ARTICLES_API_TOKEN=secret-token
# MARKETING_BLOG_URL=https://www.blackridgeresearch.com/
# Query keys appended to outbound article/show-more URLs (?sector=&date= in DD-MM-YYYY)
# MARKETING_LINK_QUERY_SECTOR=sector
# MARKETING_LINK_QUERY_DATE=date
# Weekly marketing send day: 0-6 (Sun-Sat) or name (sunday, thursday). Used when newsletter_preferences.frequency=weekly
# MARKETING_MAIL_WEEKLY_DAY=sunday
# Time for Laravel scheduler: marketing:send dual jobs (daily + weekly)
# MARKETING_MAIL_SEND_AT=09:00
# Optional: if set, HTTP /digest/marketingmail must include ?key=THIS_VALUE (curl/wget crons)
# MARKETING_MAIL_HTTP_CRON_KEY=
# Preferred cron: * * * * * php -q /path/to/artisan schedule:run
# HTTP alternative (use long timeout). Default hits daily + weekly in one request (recommended):
# curl -fsS --max-time 900 "https://YOUR-HOST/digest/marketingmail?frequency=both"
# Or omit frequency= (same as both). Split only if needed:
# curl -fsS --max-time 900 "https://YOUR-HOST/digest/marketingmail?frequency=daily"
# curl -fsS --max-time 900 "https://YOUR-HOST/digest/marketingmail?frequency=weekly"
# After deploy: php artisan migrate (adds marketing_mail_send_logs for marketing email audit)
